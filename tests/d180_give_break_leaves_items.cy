// Stopping early would leave the items not reached yet with nobody to give them.
// trace: D180, D2, D128
@config(default);
import std;

struct.must_Give open_file:
    fd: i32;
end struct.must_Give open_file

fn close [$f: Given open_file] -> void:
    std::io::fmt_print("closing {}{newln}", $f.fd);
    finish $f;
    return void;
end fn close

fn.main [] -> void:
    let $files: std::list<open_file>[len.max: inf items] = [open_file[fd = 3], open_file[fd = 4]];
    for $f in Give $files:
        close(Give $f);
        break;
    end for
    return void;
end fn.main
